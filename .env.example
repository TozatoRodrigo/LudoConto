# ===========================================
# LUDO CONTO - CONFIGURAÇÃO DE AMBIENTE
# ===========================================

# OpenAI API Key
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-sua-chave-da-openai-aqui

# Porta do servidor (para desenvolvimento local)
# Firebase App Hosting usa PORT=8080 automaticamente
PORT=8080

# ===========================================
# FIREBASE ADMIN SDK
# ===========================================
# Obtenha essas informações do arquivo JSON baixado do Firebase Console
# Configurações do projeto → Contas de serviço → Gerar nova chave privada

# ID do projeto Firebase
FIREBASE_PROJECT_ID=seu-projeto-id

# Email da conta de serviço
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com

# Chave privada (mantenha as aspas e quebras de linha \n)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_PRIVADA_COMPLETA_AQUI\n-----END PRIVATE KEY-----\n"

# ===========================================
# INSTRUÇÕES:
# ===========================================
# 1. Copie este arquivo para .env
# 2. Substitua os valores pelos seus dados reais
# 3. NUNCA commite o arquivo .env (ele está no .gitignore)
# 4. Para deploy, configure essas variáveis na plataforma de hosting