{
  "name": "ludo-conto",
  "version": "1.0.0",
  "description": "Site para gerar histórias infantis personalizadas",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "echo 'Build completed'",
    "deploy": "firebase deploy",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:apphosting": "firebase deploy --only apphosting",
    "deploy:firestore": "firebase deploy --only firestore",
    "serve": "firebase serve",
    "check": "node verificar-config.js",
    "setup": "npm install && echo 'Setup completed - Configure .env and run npm start'"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^12.0.0",
    "openai": "^4.20.1",
    "stripe": "^18.3.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
